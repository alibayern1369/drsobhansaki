# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=
# Generic HTTPS SMS adapter: POST {to,message}; choose production provider mapping.
SMS_PROVIDER=development
SMS_API_URL=
SMS_API_KEY=
# Development ONLY. Set your own six-digit value; never printed by the app.
DEV_OTP_CODE=
# JSON mapping from admin user UUID to a distinct base32 TOTP secret.
ADMIN_TOTP_SECRETS={}
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CRON_SECRET=
ALLOW_DEV_SEED=false
TEST_DATABASE_URL=
ALLOW_DB_TEST=false
