# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=
# Stable 32+ character key for encrypted admin TOTP and SMS credentials.
SETTINGS_ENCRYPTION_KEY=
# Generic HTTPS SMS adapter: POST {to,message}; choose production provider mapping.
SMS_PROVIDER=development
SMS_API_URL=
SMS_API_KEY=
# MeliPayamak REST: approved shared-service pattern with one OTP variable.
# Select SMS_PROVIDER=melipayamak only after these values are configured.
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_OTP_BODY_ID=
# Optional sender for non-OTP appointment notifications.
MELIPAYAMAK_FROM=
# Development ONLY. Set your own six-digit value; never printed by the app.
DEV_OTP_CODE=
# JSON mapping from admin user UUID to a distinct base32 TOTP secret.
ADMIN_TOTP_SECRETS={}
# Existing PRIVATE Vercel Blob Store: Drsaki. Server-only token.
BLOB_READ_WRITE_TOKEN=
# Optional integration metadata; do not assume it is provided.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Keep false until the retention policy and permanent deletion are explicitly approved.
RECEIPT_CLEANUP_ALLOW_DELETE=false
CRON_SECRET=
ALLOW_DEV_SEED=false
TEST_DATABASE_URL=
ALLOW_DB_TEST=false

# Optional temporary PATIENT login: disabled by default, exact phone only.
# Generate a private six-digit code; expires must be within the next 24 hours.
# Never commit the actual phone/code. Remove these after SMS is configured.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_PHONE=
TEST_LOGIN_CODE=
TEST_LOGIN_EXPIRES_AT=
